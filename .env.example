# FinSight Environment Configuration Example

# FastAPI Backend Settings
PROJECT_NAME="FinSight Smart Financial Intelligence API"
VERSION="2.0.0"
API_V1_STR="/api"
TAX_REGIME_YEAR="FY 2025-26"

# Database Configuration
# Default: SQLite file in root directory
DATABASE_URL="sqlite:///./finsight.db"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","*"]
